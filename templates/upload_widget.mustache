{{!
    @template mod_fastpix/upload_widget

    Drop zone + auto-start upload + post-upload preview, rendered inside the
    [data-region="fastpix-upload-widget"] div emitted by mod_form.

    Hard contract (consumed by amd/build/upload_widget.min.js):
      [data-region="fastpix-upload-picker"]   — outer panel; AMD toggles .hidden
      [data-region="fastpix-upload-dropzone"] — dashed drop target
      [data-region="fastpix-upload-input"]    — the ONLY <input type="file"> in the widget
      [data-region="fastpix-upload-progress"] — progress region (hidden initially)
      [data-region="fastpix-upload-bar"]      — invisible native <progress> kept for AMD writes
      [data-region="fastpix-upload-bar-fill"] — visible magenta fill div (NEW)
      [data-region="fastpix-upload-percent"]
      [data-region="fastpix-upload-status"]   — error alert (hidden initially)
      [data-region="fastpix-upload-preview"]  — post-upload preview (hidden initially)
      [data-region="fastpix-upload-preview-name"]
      [data-region="fastpix-upload-preview-status"]

    Inline #ff0050 is the FastPix brand magenta. Component-scoped <style> block
    is required for :focus-within / hover semantics that no Bootstrap utility
    expresses cleanly. No CSS file is added per project policy.
}}
<div class="fastpix-upload" data-region="fastpix-upload-picker">
    <style>
        .fastpix-upload__dropzone {
            position: relative;
            overflow: hidden;
            border: 2px dashed #d1d5db;
            border-radius: 1rem;
            padding: 4rem 2rem;
            background: #fff;
            transition: border-color .15s ease, background-color .15s ease;
        }
        .fastpix-upload__dropzone.is-dragging {
            border-color: #ff0050;
            background: rgba(255, 0, 80, .03);
        }
        .fastpix-upload__dropzone:focus,
        .fastpix-upload__dropzone:focus-within {
            outline: 3px solid rgba(255, 0, 80, .15);
            outline-offset: 2px;
            /* Resting border colour stays neutral on keyboard focus per D3. */
            border-color: #d1d5db;
        }
        .fastpix-upload__dropzone > [data-region="fastpix-upload-input"] {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            pointer-events: auto;
            z-index: 2;
        }
    </style>

    {{! Drop zone — entire surface is clickable + a real drop target. }}
    <div class="fastpix-upload__dropzone d-flex flex-column align-items-center justify-content-center text-center"
         data-region="fastpix-upload-dropzone"
         tabindex="0"
         role="button"
         aria-label="{{#str}}upload_droparea_title, mod_fastpix{{/str}}">
        {{! THE only <input type="file"> in the widget. opacity:0 + absolute
            cover over the dropzone hides the native "Choose File | No file
            chosen" chrome entirely. Click anywhere on the dropzone targets
            this input directly. Drag events fire here and bubble to the
            dropzone where the AMD handlers listen. }}
        <input type="file"
               accept="video/*"
               data-region="fastpix-upload-input" />
        <div class="mb-3" aria-hidden="true">
            <i class="fa fa-cloud-arrow-up" style="font-size: 36px; color: #ff0050; opacity: 0.85;"></i>
        </div>
        <p class="fw-medium mb-2" style="font-size: 15px;">
            {{#str}}upload_droparea_title, mod_fastpix{{/str}}
        </p>
        <p class="text-body-secondary mb-0 small">
            {{#str}}upload_droparea_meta, mod_fastpix{{/str}}
        </p>
    </div>

    {{! Format help row. The "and more." in upload_supported_formats covers
        the long-tail formats; a dedicated docs link will land in v1.1 with
        the help_icon component once a FastPix-side doc URL is approved. }}
    <p class="d-flex align-items-center flex-wrap mt-3 mb-0 text-body-secondary small">
        <i class="fa fa-circle-info me-2" aria-hidden="true"></i>
        <span>{{#str}}upload_supported_formats, mod_fastpix{{/str}}</span>
    </p>

    {{! Live progress region. Custom magenta bar; native <progress> kept
        invisible for AMD writes (also drives screen-reader announcements
        via aria-label). }}
    <div class="mt-3" data-region="fastpix-upload-progress" hidden>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="small text-body">{{#str}}upload_progress_label, mod_fastpix{{/str}}</span>
            <span class="small text-body" data-region="fastpix-upload-percent">0%</span>
        </div>
        <div class="rounded-pill bg-body-secondary" style="height: 6px; overflow: hidden;">
            <div data-region="fastpix-upload-bar-fill"
                 style="background-color:#ff0050;height:100%;width:0%;transition:width .15s linear;border-radius:inherit;"></div>
        </div>
        <progress value="0" max="100"
                  data-region="fastpix-upload-bar"
                  aria-label="{{#str}}upload_progress_aria, mod_fastpix{{/str}}"
                  style="appearance:none;height:0;width:0;opacity:0;position:absolute;"></progress>
    </div>

    {{! Error/status — only revealed on failures (success goes to the preview row). }}
    <div class="mt-3 small"
         data-region="fastpix-upload-status"
         role="status"
         aria-live="polite"
         hidden></div>

</div>
