{{!
    @template mod_fastpix/upload_widget

    Unified Video source panel: purple-gradient outer frame containing a
    white drop-zone card on top and a URL upload row below. Both inputs
    are visible at once — no pill toggle. AMD writes source_type into the
    hidden mform field based on which surface the user touched.

    Hard contract (consumed by amd/build/upload_widget.min.js):
      [data-region="fastpix-upload-widget"]   — outer wrapper from mod_form
      [data-region="fastpix-upload-picker"]   — gradient panel root
      [data-region="fastpix-upload-dropzone"] — white drop target
      [data-region="fastpix-upload-input"]    — the ONLY <input type="file">
      [data-region="fastpix-upload-progress"] — progress region (hidden)
      [data-region="fastpix-upload-bar"]      — native <progress> (a11y target)
      [data-region="fastpix-upload-bar-fill"] — visible magenta fill div
      [data-region="fastpix-upload-percent"]
      [data-region="fastpix-upload-status"]   — error / success message
      [data-region="fastpix-urlpull-status"]  — URL pull status line
      [name="source_url"]                     — visible URL input
      [name="validate_url"]                   — URL Upload button

    Inline #5D09C7 is the FastPix purple. Component-scoped <style> for
    gradient + dashed border (no Bootstrap utility expresses linear-gradient).
}}
<div class="fastpix-upload" data-region="fastpix-upload-picker">
    <style>
        .fastpix-upload__panel {
            background: linear-gradient(135deg, #E9D5FF 0%, #FED7AA 100%);
            border-radius: 1rem;
            padding: 28px;
        }
        .fastpix-upload__dropzone {
            position: relative;
            overflow: hidden;
            border: 2px dashed #d1d5db;
            border-radius: 0.5rem;
            padding: 4rem 2rem;
            background: #fff;
            transition: border-color .15s ease, background-color .15s ease;
        }
        .fastpix-upload__dropzone.is-dragging {
            border-color: #5D09C7;
            background: rgba(93, 9, 199, .04);
        }
        .fastpix-upload__dropzone:focus,
        .fastpix-upload__dropzone:focus-within {
            outline: 3px solid rgba(93, 9, 199, .18);
            outline-offset: 2px;
            border-color: #d1d5db;
        }
        .fastpix-upload__dropzone > [data-region="fastpix-upload-input"] {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            pointer-events: auto;
            z-index: 1;
        }
        .fastpix-upload__browse {
            color: #5D09C7;
            text-decoration: underline;
            cursor: pointer;
            position: relative;
            z-index: 2;
        }
        .fastpix-upload__urlbtn {
            background-color: #5D09C7;
            color: #fff;
            border: 1px solid #5D09C7;
            white-space: nowrap;
        }
        .fastpix-upload__urlbtn:hover,
        .fastpix-upload__urlbtn:focus {
            background-color: #4a07a0;
            border-color: #4a07a0;
            color: #fff;
        }
        .fastpix-upload__urlbtn:disabled {
            opacity: 0.65;
        }
        /* Kill Bootstrap's blue focus box-shadow on the URL input — that's
         * the ring that was visually clipping into the gradient container.
         * Border-color stays at its default light grey on focus so the input
         * shape doesn't shift, but no glow / outline. Keyboard users keep
         * a subtle :focus-visible cue via the panel's own dropzone ring. */
        .fastpix-upload__panel input[type="url"][name="source_url"]:focus,
        .fastpix-upload__panel input[type="url"][name="source_url"]:focus-visible,
        .fastpix-upload__panel input[type="url"][name="source_url"]:active {
            outline: none !important;
            box-shadow: none !important;
            border-color: #d1d5db !important;
        }
    </style>

    <div class="fastpix-upload__panel">

        {{! White drop-zone card. The clickable surface AND a real drop target.
            "Browse" is rendered as a separate link (z-index above the
            transparent file input) so it can have the underlined-purple
            affordance while the rest of the card just opens the file picker. }}
        <div class="fastpix-upload__dropzone d-flex flex-column align-items-center justify-content-center text-center"
             data-region="fastpix-upload-dropzone"
             tabindex="0"
             role="button"
             aria-label="{{#str}}videosource_dropzone_text_before, mod_fastpix{{/str}}">
            <input type="file"
                   accept="video/*"
                   data-region="fastpix-upload-input" />
            <div class="mb-3" aria-hidden="true">
                <i class="fa fa-cloud-arrow-up" style="font-size: 36px; color: #5D09C7;"></i>
            </div>
            <p class="fw-medium mb-2" style="font-size: 15px;">
                <span>{{#str}}videosource_dropzone_text_before, mod_fastpix{{/str}}</span>
                <a href="#"
                   data-action="fastpix-browse-trigger"
                   class="fastpix-upload__browse fw-medium">{{#str}}videosource_dropzone_browse, mod_fastpix{{/str}}</a>
            </p>
            <p class="text-body-secondary mb-0 small">
                {{#str}}videosource_dropzone_meta, mod_fastpix{{/str}}
            </p>
        </div>

        {{! Live progress region — replaces the dropzone visual during upload.
            Magenta -> purple to match the FastPix accent on this panel. }}
        <div class="mt-3" data-region="fastpix-upload-progress" hidden>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-body">{{#str}}upload_in_progress, mod_fastpix{{/str}}</span>
                <span class="small text-body" data-region="fastpix-upload-percent">0%</span>
            </div>
            <div class="rounded-pill bg-body-secondary" style="height: 6px; overflow: hidden;">
                <div data-region="fastpix-upload-bar-fill"
                     style="background-color:#5D09C7;height:100%;width:0%;transition:width .15s linear;border-radius:inherit;"></div>
            </div>
            <progress value="0" max="100"
                      data-region="fastpix-upload-bar"
                      style="appearance:none;height:0;width:0;opacity:0;position:absolute;"></progress>
        </div>

        {{! Inline status (errors red, success green). Always inside the panel. }}
        <div class="mt-3 small"
             data-region="fastpix-upload-status"
             role="status"
             aria-live="polite"
             hidden></div>

        {{! Or upload using video URL — single horizontal row. }}
        <p class="fw-medium small mt-4 mb-2 text-body">
            {{#str}}videosource_urlpull_label, mod_fastpix{{/str}}
        </p>
        <div class="d-flex flex-wrap align-items-stretch gap-2">
            <input type="url"
                   name="source_url"
                   class="form-control flex-grow-1"
                   placeholder="{{#str}}videosource_urlpull_placeholder, mod_fastpix{{/str}}"
                   autocomplete="off"
                   spellcheck="false"
                   style="min-width:16rem;background:#fff;" />
            <button type="button"
                    name="validate_url"
                    class="btn fastpix-upload__urlbtn px-4 fw-medium ml-4">
                {{#str}}videosource_urlpull_button, mod_fastpix{{/str}}
            </button>
        </div>
        <div data-region="fastpix-urlpull-status"
             class="text-body-secondary small mt-2"></div>
    </div>
</div>
